que: https://www.geeksforgeeks.org/problems/kth-smallest-element5635/1              ==>> 2:22:20

class Solution {
    public int kthSmallest(int[] arr, int k) {
        int n = arr.length;
        for(int i=0;i<k;i++) {
            int min = Integer.MAX_VALUE, mindx = -1;
            for(int j=i;j<n;j++) {
                if (arr[j] < min) {
                    min = arr[j];
                    mindx = j;
                }
            }
            int temp = arr[i];
            arr[i] = arr[mindx];
            arr[mindx] = temp;
        }
        return arr[k-1];
    }
}
